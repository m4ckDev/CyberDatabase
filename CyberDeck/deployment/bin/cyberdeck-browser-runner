#!/bin/bash

set -Eeuo pipefail
umask 077

UID_VALUE="${1:-}"
URL="${2:-}"

[[ "$UID_VALUE" =~ ^[0-9]+$ ]] || {
    echo "invalid user id" >&2
    exit 2
}

[[ "$URL" == http://* || "$URL" == https://* ]] || {
    echo "only http and https URLs are allowed" >&2
    exit 2
}

NS="cdvpn-${UID_VALUE}"

ip netns list |
grep -q "^${NS}\b" || {
    echo "VPN is disconnected" >&2
    exit 3
}

ip netns exec "$NS"     curl     -fsS     --max-time 6     https://api.ipify.org     >/dev/null 2>&1 || {
        echo "VPN connection has no Internet access" >&2
        exit 4
    }

exec ip netns exec "$NS" \
    /opt/cyberdeck/venv/bin/python \
    /opt/cyberdeck/api/browser_render.py \
    "$URL"
