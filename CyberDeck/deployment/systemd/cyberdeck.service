[Unit]
Description=CyberDeck API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=cyberdeck
Group=cyberdeck
WorkingDirectory=/opt/cyberdeck/api
EnvironmentFile=/opt/cyberdeck/config/.env
ExecStart=/opt/cyberdeck/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
