# =============================================
# .gitignore for multi-llm-router
# This file tells Git what to NEVER upload
# =============================================

# --- SECRETS (NEVER upload these!) ---
.env                   # Your real API keys live here — keep it local only
*.env                  # Any file ending in .env

# --- Python ---
__pycache__/           # Python's auto-generated cache folders
*.py[cod]              # Compiled Python files
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/

# --- Logs ---
logs/*.log             # Log files generated at runtime
*.log

# --- IDE / Editor Files ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store              # Mac OS folder metadata

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
