# =============================================
# .env.example — API Key Template
# Copy this file, rename it to .env,
# and fill in your real keys.
# NEVER commit the real .env file to GitHub!
# =============================================

# Which model to use as the default fallback
DEFAULT_MODEL=openai

# --- OpenAI ---
OPENAI_API_KEY=your-openai-api-key-here

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Google Gemini ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Grok (xAI) ---
GROK_API_KEY=your-grok-api-key-here

# --- Ollama (local, no key needed) ---
# The URL where your local Ollama server is running
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Logging ---
LOG_LEVEL=INFO         # Options: DEBUG, INFO, WARNING, ERROR
LOG_TO_FILE=true       # Set to false to only print to terminal
